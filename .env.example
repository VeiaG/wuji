DATABASE_URI=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Cloudflare R2 (S3-сумісне сховище для upload-колекцій: media, user-uploads)
# Якщо R2_BUCKET порожній — плагін вимкнено, файли лежать на локальному volume.
R2_BUCKET=my-bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# S3 API endpoint з дашборду R2 — лише для завантаження, не для роздачі файлів
R2_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com
# Публічний URL бакета: кастомний домен (рекомендовано) або *.r2.dev субдомен
R2_PUBLIC_URL=https://media.yourdomain.com
